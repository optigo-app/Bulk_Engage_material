									,Q.GrossDiamondWeight
									,isnull(Q.[Weight],0)+isnull(Q.weight_SizeWise,0)),0) as wt
						,isnull(Q.pieces,0)+isnull(Q.pieces_SizeWise,0) as pcs	
						,concat(@_ImageLogicalPath,@_Image_ukey,''Design_Image/Design_Thumb/'',Q.designno,''~1.jpg'') as imagepath
					from ['+@DBNAME+'].dbo.[Quotationmanagement_designdiamonddetail] as Q with (nolock)
					inner join (
						select 
							 distinct B.iStore_QuotationNo 
							 ,B.id as jid
							,B.SerialJobNo
						from ['+@DBNAME+'].dbo.ProductionManagement_SerialNoBook as B with (nolock)
						inner join (
								SELECT TRIM(value) AS SerialJobNo
								FROM STRING_SPLIT(
										REPLACE(' + @serialjobnos + ', '''''''', ''''),
										'',''
								)
						) as F
						ON B.SerialJobNo = F.SerialJobNo
					) as J
						ON Q.QuotationNo=J.iStore_QuotationNo
					where Q.MasterManagement_DiamondStoneTypeid in (1,2,3,5)
					'
					

		SET @SQL2 = '
					select 
						 string_agg(L.id,'','') as txnid
						,string_agg(L.Quotation_diamonddetailid,'','') as qid
						,J.jid as jid
						,L.SerialJobNo
						,L.InventoryManagement_invoice_master_item_id as itemid
						,L.master_itemname as item
						,L.materialtypeid
						,L.materialtypename
						,L.shapeid
						,L.shape		
						,L.Qualityid
						,L.Quality						
						,L.color
						,L.size						
						,ISNULL(L.INV_findingtypename,'''') as INV_findingtypename
						,ISNULL(L.INV_findingAccessories,'''') as INV_findingAccessories	
						,SUM(ISNULL(L.InventoryManagement_invoice_Issweight,0)) as wt
						,SUM(ISNULL(L.InventoryManagement_invoice_Isspcs,0)) as pcs		
						,string_agg(L.InventoryManagement_invoice_rfbag,'','') as rfbags
					from ['+@DBNAME+'].dbo.TransactionLogmanagement_ProductionUpdateLog as L with (nolock)
					inner join (
						select 
							distinct B.iStore_QuotationNo 
							,B.id as jid
							,B.SerialJobNo
						from ['+@DBNAME+'].dbo.ProductionManagement_SerialNoBook as B with (nolock)
						inner join (
								SELECT TRIM(value) AS SerialJobNo
								FROM STRING_SPLIT(
									REPLACE(' + @serialjobnos + ', '''''''', ''''),
									'',''
								)
						) as F
						ON B.SerialJobNo = F.SerialJobNo
					) as J
						ON L.SerialJobNo=J.SerialJobNo
					where ISNULL(L.isengage,0)>0
					and ISNULL(L.InventoryManagement_invoice_master_item_id,0) in (1,2,3,5)
					and ISNULL(L.[action],'''')=''Issue JobNo''	
					group by						
						 J.jid
						,L.SerialJobNo
						,L.InventoryManagement_invoice_master_item_id
						,L.master_itemname
						,L.materialtypeid
						,L.materialtypename
						,L.shapeid
						,L.shape		
						,L.Qualityid
						,L.Quality					
						,L.color
						,L.size	
						,ISNULL(L.INV_findingtypename,'''')
						,ISNULL(L.INV_findingAccessories,'''')
					
				END
				ELSE
				BEGIN
					SELECT 
						 1 as stat
						,''Certain jewellery jobs are invalid and require your attention!'' as stat_msg
						,1001 as stat_code
						,''null'' as device_token
				END
			';
		
		PRINT(@SQL)
		PRINT(@SQL1)
		PRINT(@SQL2)
		EXEC(@SQL+@SQL1+@SQL2)
	END
	ELSE IF(ISNULL(@mode,'') = 'valdbags')
	BEGIN
		SET @SQL = '
				DECLARE 
					 @validjobs AS NVARCHAR(MAX)=''''
					,@invalidjobs AS NVARCHAR(MAX)=''''
					,@_validjobs AS NVARCHAR(MAX)=''''
					,@_invalidjobs AS NVARCHAR(MAX)='''';

				WITH InputList AS (
					SELECT TRIM(value) AS rfbag
					FROM STRING_SPLIT(
							REPLACE(' + @rfbags + ', '''''''', ''''),
							'',''
					)
				)
				SELECT 	
					 @validjobs=STRING_AGG(IIF(s.rfbag IS NOT NULL ,i.rfbag,''''),'','')
					,@invalidjobs=STRING_AGG(IIF(s.rfbag IS NOT NULL ,'''',i.rfbag),'','')				
				FROM InputList i
				LEFT JOIN ['+@DBNAME+'].dbo.inventorymanagement_invoice s WITH (NOLOCK)
				   ON s.rfbag = i.rfbag
				   AND s.isstockonhand='+convert(nvarchar(20),@isstockonhand)+';


				SELECT 
					@_validjobs=STRING_AGG(value, '','')
				FROM STRING_SPLIT(@validjobs, '','')
				WHERE LTRIM(RTRIM(value)) <> '''';

				SELECT 
					@_invalidjobs=STRING_AGG(value, '','')
				FROM STRING_SPLIT(@invalidjobs, '','')
				WHERE LTRIM(RTRIM(value)) <> '''';

				SELECT
					ISNULL(@_validjobs,'''') AS validjobs
					,ISNULL(@_invalidjobs,'''') AS invalidjobs
			'
		SET @SQL1 = '
				IF(ISNULL(@_invalidjobs,'''')='''')
				BEGIN
					declare @_defcompid as int=0
					select top(1) 
						@_defcompid=id 
					from ['+@DBNAME+'].dbo.Usermanagement_systemloginmaster with (nolock)
					where isnull(isDefaultCustomer,0)=1

					select 
						 B.rfbag					
						,B.master_item_id as itemid
						,isnull(B.materialtypeid,0) as materialtypeid 
						,isnull(B.materialtypename,'''') as materialtypename
						,B.shapeid
						,B.shape
						,B.Qualityid
						,B.Quality
						,B.colorid
						,B.color
						,isnull(B.Size,'''') as Size
						,isnull(B.diamond_Custome_Size,'''') as customesize
						,isnull(B.master_findingtype_id,0) as findingtypeid
						,isnull(B.findingtypename,'''') as findingtypename
						,isnull(B.findingAccessoriesId,0) as findingAccessoriesid
						,isnull(B.findingAccessories,'''') as findingAccessories
						,isnull(B.TotalRemainingWeight,0) as wt
						,isnull(B.TotalRemainingPcs,0) as pcs
						,iif(isnull(B.istoreCust_ID,0)=convert(nvarchar(20),@_defcompid),''company'',''customer'') as supplier						
					from ['+@DBNAME+'].dbo.inventorymanagement_invoice as B with (nolock)
					inner join (
							SELECT TRIM(value) AS rfbag
							FROM STRING_SPLIT(
									REPLACE(' + @rfbags + ', '''''''', ''''),
									'',''
							)
					) as F
					ON B.rfbag = F.rfbag
					
					
				END
				ELSE
				BEGIN
					SELECT 
						 1 as stat
						,''Certain raw material bags are invalid and require your attention.!'' as stat_msg
						,1001 as stat_code
						,''null'' as device_token
				END
			';
		
		PRINT(@SQL)
		PRINT(@SQL1)
		EXEC(@SQL+@SQL1)
	END
	ELSE IF(ISNULL(@mode,'') = 'returnall')
	BEGIN
		SET @SQL = '				
				update I
				set  I.[diamondctw]=IIF(isnull(I.master_item_id,0)=3,isnull(I.[diamondctw],0)+isnull(L.Issweight,0),isnull(I.[diamondctw],0))
					,I.[diamondpcs]=IIF(isnull(I.master_item_id,0)=3,isnull(I.[diamondpcs],0)+isnull(L.Isspcs,0),isnull(I.[diamondpcs],0))
					,I.[fancystonectw]=IIF(isnull(I.master_item_id,0) in (4,7),isnull(I.[fancystonectw],0)+isnull(L.Issweight,0),isnull(I.[fancystonectw],0))		
					,I.[fancystonepcs]=IIF(isnull(I.master_item_id,0) in (4,7),isnull(I.[fancystonepcs],0)+isnull(L.Isspcs,0),isnull(I.[fancystonepcs],0))
					,I.[findingctw]=IIF(isnull(I.master_item_id,0)=5,isnull(I.[findingctw],0)+isnull(L.Issweight,0),isnull(I.[findingctw],0))
					,I.[findingpcs]=IIF(isnull(I.master_item_id,0)=5,isnull(I.[findingpcs],0)+isnull(L.Isspcs,0),isnull(I.[findingpcs],0))
					,I.[TotalRemainingWeight]=isnull(I.[TotalRemainingWeight],0)+isnull(L.Issweight,0)
					,I.[TotalRemainingPcs]=isnull(I.[TotalRemainingPcs],0)+isnull(L.Isspcs,0)	
				from ['+@DBNAME+'].[dbo].InventoryManagement_invoice as I
				INNER JOIN (
					select 
						InventoryManagement_invoice_rfbag as rfbag
						,SUM(isnull(InventoryManagement_invoice_Issweight,0)) as Issweight	
						,SUM(isnull(InventoryManagement_invoice_Isspcs,0)) as Isspcs
					from ['+@DBNAME+'].[dbo].TransactionLogmanagement_ProductionUpdateLog with (nolock)
					where id in (' + @txnid + ')
					group by InventoryManagement_invoice_rfbag
				) as L
				ON I.rfbag=L.rfbag 
				'
			SET @SQL1 = '
				INSERT INTO ['+@DBNAME+'].[dbo].[raw_material_history]
					([EntryDate]
					,[InvoiceDate]
					,[Eventname]
					,[Invoice]
					,[opening]
					,[Inward]
					,[Outward]
					,[rfbagno]
					,[customercode]
					,[loginuserid]
					)
				select 
					isnull([dbo].[UTC_CSERVERLOCAL](getdate()),getdate())
					,isnull([dbo].[UTC_CSERVERLOCAL](getdate()),getdate())
					,CONCAT(''Extra Remain (From '', InventoryManagement_invoice_rfbag, '')'')
					,id as Invoice
					,0 as opening
					,InventoryManagement_invoice_Issweight as Inward
					,0 as Outward
					,InventoryManagement_invoice_rfbag as torfbag
					,INV_istoreCust_Customercode as customercode
					,'''+@appuserid+''' as loginuserid
				from ['+@DBNAME+'].[dbo].TransactionLogmanagement_ProductionUpdateLog with (nolock)
				where id in (' + @txnid + ')

				delete from ['+@DBNAME+'].[dbo].TransactionLogmanagement_ProductionUpdateLog
				where id in (' + @txnid + ')

				SELECT 
					1 as stat
					,''returned jewellery engaged materials successfully !'' as stat_msg
					,1002 as stat_code
					,''null'' as device_token
			';
		
		PRINT(@SQL)		
		PRINT(@SQL1)	
		EXEC(@SQL+@SQL1)
	END
	ELSE IF(ISNULL(@mode,'') = 'engagesave')
	BEGIN
		DECLARE 
			@schedular_token AS NVARCHAR(24)=
						LEFT(
							CONVERT(varchar(64),
									HASHBYTES('SHA2_256', CONVERT(varchar(36), NEWID())),
									2),
							24
						)
		;


		SET @SQL='
			INSERT INTO ['+@DBNAME+'].[dbo].[bulkEngDetail]
			(
				[entrydate]
				,[jid]
				,[qid]
				,[eid]
				,[rfbag]
				,[wt]
				,[pcs]
				,[txnid]
				,[appuserid]
				,[schedular_token]
			)
			SELECT 
				isnull([dbo].[UTC_CSERVERLOCAL](getdate()),getdate())
				,jid
				,qid
				,eid
				,rfbag
				,wt	
				,pcs
				,txnid
				,'''+@appuserid+'''
				,'''+@schedular_token+'''
			FROM OPENJSON('''+@p+''', ''$.data'')
			WITH (
				jid NVARCHAR(20),
				qid NVARCHAR(20),
				eid NVARCHAR(20),
				rfbag NVARCHAR(20),
				wt DECIMAL(18,2),
				pcs INT,
				txnid INT
			);
			
			INSERT INTO ['+@DBNAME+'].[dbo].[bulkEngDetail_Schedular]
				([entrydate]
				,[userid]
				,[ipaddress]
				,[formname]
				,[schedular_token])
			VALUES
			(	isnull([dbo].[UTC_CSERVERLOCAL](getdate()),getdate())
				,'''+@appuserid+'''
				,'''+@IPAddress+'''
				,'''+@FormName+'''
				,'''+@schedular_token+'''
			)


			SELECT 
				1 as stat
				,''the jewellery materials have been successfully engaged!'' as stat_msg
				,1002 as stat_code
				,''null'' as device_token			

		'	
		print (@SQL)
		EXEC (@SQL)

		SET @SQL='
			exec ['+@DBNAME+'].dbo.[bulkEngProcess] 
							 '''+@schedular_token+'''
							,'''+@appuserid+'''
							,'''+@IPAddress+'''
							,'''+@FormName+'''
		'
		print (@SQL)
		EXEC (@SQL)
	END
	ELSE
	BEGIN
		SELECT -1 as stat 
		,'Invalid Mode' as stat_msg
	END
	

			
END

